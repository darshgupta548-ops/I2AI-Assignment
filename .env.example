# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./backend/smart_hostel_energy.db

# Google Gemini API
# Provide your Google Gemini API key to enable structured energy analytics interpretation.
# If left empty, the application runs fully with local analytical rule-based interpretation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
